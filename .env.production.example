# Fund Road · variables de production (copier en .env.production, jamais commité)

# Site et base
APP_URL=https://fund-road.com
POSTGRES_PASSWORD=                 # openssl rand -base64 36
BETTER_AUTH_SECRET=                # openssl rand -base64 36
TUNNEL_TOKEN=                      # jeton du tunnel Cloudflare
BEHIND_CLOUDFLARE=1                # adresse IP fiable : en-tête cf-connecting-ip
REQUIRE_EMAIL_VERIFICATION=true
ADMIN_EMAILS=                      # adresses des administrateurs, séparées par des virgules

# IA (API compatible OpenAI)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# secours automatique si le principal échoue (panne, saturation, délai)
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
FREE_ANALYSES=1                    # analyses offertes par mois (offre Découverte)
PILOT_ANALYSES=3

# Emails transactionnels
SMTP_URL=                          # smtps://utilisateur:motdepasse@serveur:465
MAIL_FROM="Fund Road <adresse@domaine>"

# Stripe (clé d'organisation : préciser le compte visé)
STRIPE_SECRET_KEY=
STRIPE_CONTEXT=                    # acct_… du compte Fund Road
STRIPE_WEBHOOK_SECRET=             # whsec_… du webhook /api/billing/webhook

# Facultatif
ADVISOR_ORG_ID=                    # organisation conseil associée aux dossiers
